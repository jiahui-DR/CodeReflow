{
  "gitlab": {
    "url": "https://gitlab.yourcompany.com",
    "token": "your-gitlab-personal-access-token",
    "project_id": 12345
  },
  "git": {
    "repo_path": "/absolute/path/to/your/git/repository",
    "target_branch": "dev_master",
    "search_days": 30
  },
  "fingerprint": {
    "ignore_patterns": [
      "^\\s*#.*$",
      "^\\s*$",
      "^\\s*import",
      "^\\s*from.*import",
      "^\\s*//.*$",
      "^\\s*/\\*.*\\*/$",
      "^\\s*package",
      "^\\s*public class"
    ],
    "code_extensions": [
      ".py", ".java", ".js", ".ts", ".jsx", ".tsx",
      ".cpp", ".c", ".h", ".hpp", ".go", ".rs", ".rb",
      ".php", ".scala", ".kt", ".swift", ".cs", ".vb",
      ".sql", ".yml", ".yaml", ".xml", ".json"
    ]
  },
  "cache": {
    "backend": "memory",
    "max_size": 1000,
    "default_ttl": 3600,
    "cache_dir": ".cache"
  },
  "performance": {
    "max_workers": 4,
    "batch_size": 10,
    "max_commits": 1000,
    "enable_metrics": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "core_reflow.log",
    "max_file_size": 10485760,
    "backup_count": 5
  },
  "output": {
    "format": "console",
    "verbose": false
  }
}
